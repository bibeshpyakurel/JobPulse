# ── Gmail / Google Cloud ────────────────────────────────────────────────────
# The Gmail address JobPulse monitors
GMAIL_USER_EMAIL=you@gmail.com

# Google Cloud project that owns the Pub/Sub topic
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Pub/Sub topic and subscription names (defaults shown)
PUBSUB_TOPIC_NAME=gmail-job-alerts
PUBSUB_SUBSCRIPTION_NAME=gmail-job-alerts-sub

# Service-account credentials — either:
#   (a) the absolute path to a JSON key file, OR
#   (b) the raw JSON string (useful for Render environment variables)
GOOGLE_CREDENTIALS_JSON=/path/to/service-account-key.json

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006   # your Twilio number
TWILIO_TO_NUMBER=+1xxxxxxxxxx    # your personal number

# ── SendGrid ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=alerts@yourdomain.com   # must be verified in SendGrid
SENDGRID_TO_EMAIL=you@gmail.com

# ── App ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=replace-with-a-long-random-string
PORT=8080
DATABASE_PATH=jobpulse.db
